   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.9, sum by (le) (rate(app_latency_seconds_bucket{mode=\"live\"}[1h])))",
     "legendFormat": ""
