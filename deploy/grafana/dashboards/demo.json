          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (test) (demo_label_checks_total{task=~\"$task\",output=\"output1\",result=\"correct\"}) or 0 * sum by (test) (demo_label_checks_total{task=~\"$task\",output=\"output1\",result=~\"correct|wrong\"})) / sum by (test) (demo_label_checks_total{task=~\"$task\",output=\"output1\",result=~\"correct|wrong\"})",
          "legendFormat": "Test {{test}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
