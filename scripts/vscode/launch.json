{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web page (opens /project)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["web", "--no-browser"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": { "pattern": "running at (http://[^ ]+)", "uriFormat": "%sproject", "action": "openExternally" }
    },
    {
      "name": "Self-test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["selftest"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "main.py with arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": "${command:pickArgs}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
