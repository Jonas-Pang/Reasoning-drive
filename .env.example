# Copy to .env and fill in your own values.
# Folder for downloaded data (default: data/ in the repository)
DATA_DIR=
# Folder that holds the labeling workspaces (UF, bdd100k, culane)
DATASETS_ROOT=
# Your OpenAI API key
OPENAI_API_KEY=
# UF NaviGator key (LiteLLM, create it under Virtual Keys with Team = navigator-toolkit) and the model profile the
# lane advisor uses (configs/api_profiles.yaml): nav_gemma4_31b_bf16 (default), nav_muse_glimmer_30b, or an OpenAI one
NAVIGATOR_API_KEY=
LANE_API_PROFILE=nav_gemma4_31b_bf16
# Name or initials written into the label files by the labeling tool (optional)
LABELER=
# Password of the Grafana user "admin" (docker compose; docs/deployment.md)
GRAFANA_ADMIN_PASSWORD=
