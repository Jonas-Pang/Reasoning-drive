# Copy this file to .env (which Git ignores) and fill in your own values.
# Where downloaded data is kept, e.g. an external drive. Leave empty to use data/ inside the repository.
# Example (macOS): DATA_DIR=/Volumes/T9/Project/Reasning_Drive/data
DATA_DIR=
# Folder that holds the labeling workspaces (UF, bdd100k, culane); relative names in config/experiment.json are resolved here.
# Example (macOS): DATASETS_ROOT=/Volumes/T9/数据集
DATASETS_ROOT=
# OpenAI API key for the model runs (lane_reasoner / experiment.ipynb). Never commit a real key.
# experiment.ipynb writes it here for you from a hidden input box.
OPENAI_API_KEY=
# Name or initials written into the label files by video_tool (optional)
LABELER=
